# Copy this file to .env and fill in what you need. .env is never uploaded.

# Free key from https://developer.dhl.com (add "Shipment Tracking - Unified" to an app).
# Leave empty to run on sample data.
DHL_API_KEY=

PORT=3100
# 127.0.0.1 = this computer only. 0.0.0.0 = phones on the same Wi-Fi can open it too.
HOST=127.0.0.1
